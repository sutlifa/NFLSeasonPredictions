# Postgres connection string. A pooled endpoint (Neon/PgBouncer) is fine --
# lib/db.ts sets prepare:false, which a transaction pooler requires.
DATABASE_URL=

# Auth.js v5 reads these by convention -- they are not referenced in code.
# AUTH_SECRET:    openssl rand -base64 32
# AUTH_GOOGLE_*:  Google Cloud console -> Credentials -> OAuth 2.0 Client ID.
# Authorised redirect URI: <origin>/api/auth/callback/google
#   -- add BOTH https://<your-domain>/api/auth/callback/google
#      and      http://localhost:3000/api/auth/callback/google
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Any random string. Sent as the x-admin-secret header to /api/admin/sync.
ADMIN_SECRET=

# Any random string. Validates the Authorization header Vercel attaches to
# the cron that pulls scores and lines. Set this in Vercel, not just locally
# -- the cron route refuses to run at all without it, deliberately, so an
# unauthenticated endpoint cannot hammer ESPN.
CRON_SECRET=

# Optional. Which season the app is showing. Defaults to 2026.
NFL_SEASON=

# No API key is needed for game data. ESPN's public endpoints are read
# anonymously (see lib/espn.ts for what that costs us).
